digraph G {
  rankdir=TB;
  fontname="Helvetica"; compound=true;
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8];
  nodesep=0.35; ranksep=0.55; splines=true;
  subgraph cluster_ui {
    label=<&laquo;package&raquo; restaurant.ui>; style="rounded,dashed"; color="#8a94a6"; fontsize=11;
  "ui.ConsoleUI" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>ConsoleUI</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>- LINE: String</U><BR/>- in: BufferedReader<BR/>- out: PrintStream<BR/>- echo: boolean</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- readLine(prompt: String): String<BR/><U>- tick(ok: boolean): String</U><BR/><U>- formatAverage(avg: OptionalDouble): String</U><BR/><U>- describeOrder(o: Order): String</U><BR/>+ showMessage(message: String)<BR/>+ showWelcome(config: GameConfig)<BR/>+ showResult(config: GameConfig, result: GameResult)<BR/>+ showTurnHeader(turn: int, maxTurns: int)<BR/>+ showEvents(heading: String, events: List&lt;String&gt;)<BR/>+ showBoard(r: Restaurant, turn: int, maxTurns: int, notices: List&lt;String&gt;, availableTasks: Map&lt;String, List&lt;String&gt;&gt;)<BR/>+ showTurnSummary(r: Restaurant, turn: int)<BR/>+ askHappyHour(): boolean<BR/>+ promptStaff(role: String, options: List&lt;String&gt;): ManagerCommand<BR/>+ showHelp()<BR/>+ showError(message: String)<BR/>+ ConsoleUI(in: BufferedReader, out: PrintStream, echo: boolean)</TD></TR>
    </TABLE>>];
  "ui.ManagerCommand" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><FONT POINT-SIZE="8">&laquo;record&raquo;</FONT><BR/><B>ManagerCommand</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- kind: ManagerCommand.Kind<BR/>- verb: String<BR/>- targetId: int<BR/>- message: String</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ parse(raw: String): ManagerCommand</U></TD></TR>
    </TABLE>>];
  "ui.ManagerCommand$Kind" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><FONT POINT-SIZE="8">&laquo;enumeration&raquo;</FONT><BR/><B>ManagerCommand.Kind</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">TASK<BR/>WAIT<BR/>HELP<BR/>QUIT<BR/>INVALID</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"> </TD></TR>
    </TABLE>>];
  }
  subgraph cluster_control {
    label=<&laquo;package&raquo; restaurant.control>; style="rounded,dashed"; color="#8a94a6"; fontsize=11;
  "control.GameController" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>GameController</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- config: GameConfig<BR/>- restaurant: Restaurant<BR/>- ui: ConsoleUI<BR/>- roster: List&lt;ManagedStaff&gt;<BR/>- cashier: Cashier<BR/>- nextCustomerId: int</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ run(): GameResult<BR/>- playTurn(turn: int)<BR/>- arrivals(turn: int, events: List&lt;String&gt;)<BR/>- happyHourRecovery(): List&lt;String&gt;<BR/>- happyHourNotice(): List&lt;String&gt;<BR/>- describeAvailable(plan: TurnPlan): Map&lt;String, List&lt;String&gt;&gt;<BR/>- offerHappyHour()<BR/>- collectChoices(): TurnPlan<BR/>- chooseTask(staff: ManagedStaff, plan: TurnPlan): StaffTask<BR/>- buildTask(staff: ManagedStaff, cmd: ManagerCommand, plan: TurnPlan): StaffTask<BR/>+ GameController(config: GameConfig, ui: ConsoleUI)</TD></TR>
    </TABLE>>];
  "control.TurnPlan" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>TurnPlan</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- tasks: List&lt;StaffTask&gt;</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ add(task: StaffTask)<BR/>+ conflicts(candidate: StaffTask): boolean<BR/>+ tablesClaimed(): int<BR/>+ willHaveOrder(c: Customer): boolean<BR/>+ findConflict(candidate: StaffTask): Optional&lt;StaffTask&gt;<BR/>+ TurnPlan()</TD></TR>
    </TABLE>>];
  "control.GameConfig" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>GameConfig</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- maxTurns: int<BR/>- tableCount: int<BR/>- minPaidCustomers: int<BR/>- minRevenueCents: int<BR/>- minAverageSatisfaction: int<BR/>- schedule: ArrivalSchedule</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ base(): GameConfig</U><BR/>+ evaluate(r: Restaurant): GameResult<BR/>+ newMenu(): Menu<BR/>+ newRestaurant(): Restaurant</TD></TR>
    </TABLE>>];
  "control.GameResult" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><FONT POINT-SIZE="8">&laquo;record&raquo;</FONT><BR/><B>GameResult</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- paidCount: int<BR/>- revenueCents: int<BR/>- averageSatisfaction: OptionalDouble<BR/>- paidTargetMet: boolean<BR/>- revenueTargetMet: boolean<BR/>- satisfactionTargetMet: boolean</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"> </TD></TR>
    </TABLE>>];
  }
