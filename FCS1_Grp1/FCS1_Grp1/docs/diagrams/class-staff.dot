digraph G {
  rankdir=TB;
  fontname="Helvetica"; compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  nodesep=0.35; ranksep=0.55; splines=true;
  subgraph cluster_control {
    label=<&laquo;package&raquo; restaurant.control>; style="rounded,dashed"; color="#8a94a6"; fontsize=11;
  "control.TurnPlan" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>TurnPlan</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- tasks: List&lt;StaffTask&gt;</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ add(task: StaffTask)<BR/>+ conflicts(candidate: StaffTask): boolean<BR/>+ tablesClaimed(): int<BR/>+ willHaveOrder(c: Customer): boolean<BR/>+ findConflict(candidate: StaffTask): Optional&lt;StaffTask&gt;<BR/>+ TurnPlan()</TD></TR>
    </TABLE>>];
  }
  subgraph cluster_staff {
    label=<&laquo;package&raquo; restaurant.staff>; style="rounded,dashed"; color="#8a94a6"; fontsize=11;
  "staff.Staff" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B><I>Staff</I></B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- role: String</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"># Staff(role: String)</TD></TR>
    </TABLE>>];
  "staff.ManagedStaff" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B><I>ManagedStaff</I></B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"> </TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><I>+ getVerbs(): List&lt;String&gt;</I><BR/><I># createTask(verb: String, target: Customer): StaffTask</I><BR/>+ taskFor(verb: String, target: Customer): Optional&lt;StaffTask&gt;<BR/>+ availableTasks(restaurant: Restaurant, plan: TurnPlan): List&lt;StaffTask&gt;<BR/># ManagedStaff(role: String)</TD></TR>
    </TABLE>>];
  "staff.Waiter" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>Waiter</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"> </TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"># createTask(verb: String, target: Customer): StaffTask<BR/>+ Waiter()</TD></TR>
    </TABLE>>];
  "staff.Chef" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>Chef</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"> </TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"># createTask(verb: String, target: Customer): StaffTask<BR/>+ Chef()</TD></TR>
    </TABLE>>];
  "staff.Host" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>Host</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"> </TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"># createTask(verb: String, target: Customer): StaffTask<BR/>+ Host()</TD></TR>
    </TABLE>>];
  "staff.Cashier" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>Cashier</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"> </TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ collectPayment(restaurant: Restaurant, turn: int): Optional&lt;String&gt;<BR/>+ Cashier()</TD></TR>
    </TABLE>>];
  "staff.StaffTask" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B><I>StaffTask</I></B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- actorRole: String<BR/>- target: Customer</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><I>+ validate(restaurant: Restaurant, plan: TurnPlan): Optional&lt;String&gt;</I><BR/><I>+ execute(restaurant: Restaurant, turn: int): String</I><BR/><U># fail(reason: String): Optional&lt;String&gt;</U><BR/><I>+ describe(): String</I><BR/>+ claimsTable(): boolean<BR/>+ createsOrder(): boolean<BR/>+ conflictsWith(other: StaffTask): boolean<BR/># StaffTask(actorRole: String, target: Customer)</TD></TR>
    </TABLE>>];
  "staff.SeatCustomerTask" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>SeatCustomerTask</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ VERB: String</U></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ validate(restaurant: Restaurant, plan: TurnPlan): Optional&lt;String&gt;<BR/>+ execute(restaurant: Restaurant, turn: int): String<BR/>+ describe(): String<BR/>+ claimsTable(): boolean<BR/>+ conflictsWith(other: StaffTask): boolean<BR/>+ SeatCustomerTask(actorRole: String, target: Customer)</TD></TR>
    </TABLE>>];
  "staff.TakeOrderTask" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>TakeOrderTask</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ VERB: String</U></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ validate(restaurant: Restaurant, plan: TurnPlan): Optional&lt;String&gt;<BR/>+ execute(restaurant: Restaurant, turn: int): String<BR/>+ describe(): String<BR/>+ createsOrder(): boolean<BR/>+ TakeOrderTask(actorRole: String, target: Customer)</TD></TR>
    </TABLE>>];
  "staff.ServeOrderTask" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>ServeOrderTask</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ VERB: String</U></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ validate(restaurant: Restaurant, plan: TurnPlan): Optional&lt;String&gt;<BR/>+ execute(restaurant: Restaurant, turn: int): String<BR/>+ describe(): String<BR/>+ ServeOrderTask(actorRole: String, target: Customer)</TD></TR>
    </TABLE>>];
  "staff.CookOrderTask" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>CookOrderTask</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ VERB: String</U></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ validate(restaurant: Restaurant, plan: TurnPlan): Optional&lt;String&gt;<BR/>+ execute(restaurant: Restaurant, turn: int): String<BR/>+ describe(): String<BR/>+ CookOrderTask(actorRole: String, target: Customer)</TD></TR>
    </TABLE>>];
  }
  subgraph cluster_model {
    label=<&laquo;package&raquo; restaurant.model>; style="rounded,dashed"; color="#8a94a6"; fontsize=11;
  "model.Restaurant" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>Restaurant</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- menu: Menu<BR/>- tables: List&lt;Table&gt;<BR/>- queue: WaitingQueue<BR/>- customers: List&lt;Customer&gt;<BR/>- happyHour: HappyHour<BR/>- revenueCents: int<BR/>- paidCount: int<BR/>- paidSatisfactionTotal: int<BR/>- servedCount: int<BR/>- unhappyDepartures: int</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ quote(c: Customer, item: MenuItem): int<BR/>+ finishEating(turn: int): List&lt;Customer&gt;<BR/>+ nextToPay(turn: int): Optional&lt;Customer&gt;<BR/>+ collectPayment(c: Customer)<BR/>+ seat(c: Customer): Table<BR/>+ serve(c: Customer, turn: int)<BR/>+ freeTableCount(): int<BR/>+ takeOrder(c: Customer): Order<BR/>+ endTurn()<BR/>+ findCustomer(id: int): Optional&lt;Customer&gt;<BR/>+ admit(c: Customer)<BR/>+ applyHappyHourRecovery(): Map&lt;Customer, Integer&gt;<BR/>+ applyWaitingLoss(): List&lt;Customer&gt;<BR/>+ Restaurant(menu: Menu, tableCount: int)</TD></TR>
    </TABLE>>];
  "model.Customer" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B><I>Customer</I></B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ START_SATISFACTION: int</U><BR/>- id: int<BR/>- arrivalTurn: int<BR/>- satisfaction: int<BR/>- state: CustomerState<BR/>- table: Table<BR/>- order: Order<BR/>- servedTurn: int<BR/>- readyToPayTurn: int<BR/>- recordedSatisfaction: int</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><I>+ getTypeName(): String</I><BR/><I>+ getLossPerWaitingTurn(): int</I><BR/>- require(expected: CustomerState)<BR/># satisfactionAtPayment(): int<BR/>+ chooseItem(menu: Menu): MenuItem<BR/>+ billFor(item: MenuItem): int<BR/>~ seatAt(t: Table)<BR/>~ placeOrder(o: Order)<BR/>~ startEating(turn: int)<BR/>~ finishEating(turn: int)<BR/>~ pay()<BR/>~ recoverSatisfaction(points: int): int<BR/>~ loseSatisfaction(): boolean<BR/>~ abandon()<BR/># Customer(id: int, arrivalTurn: int)</TD></TR>
    </TABLE>>];
  }
  "staff.ManagedStaff" -> "staff.Staff" [arrowhead=empty, color="#222222"];
  "staff.Cashier" -> "staff.Staff" [arrowhead=empty, color="#222222"];
  "staff.Waiter" -> "staff.ManagedStaff" [arrowhead=empty, color="#222222"];
  "staff.Chef" -> "staff.ManagedStaff" [arrowhead=empty, color="#222222"];
  "staff.Host" -> "staff.ManagedStaff" [arrowhead=empty, color="#222222"];
  "staff.SeatCustomerTask" -> "staff.StaffTask" [arrowhead=empty, color="#222222"];
  "staff.TakeOrderTask" -> "staff.StaffTask" [arrowhead=empty, color="#222222"];
  "staff.ServeOrderTask" -> "staff.StaffTask" [arrowhead=empty, color="#222222"];
  "staff.CookOrderTask" -> "staff.StaffTask" [arrowhead=empty, color="#222222"];
  "model.Restaurant" -> "model.Customer" [arrowtail=diamond, dir=back, color="#222222", label="customers", taillabel="1", headlabel="0..*", labeldistance=1.4];
  "control.TurnPlan" -> "staff.StaffTask" [arrowtail=diamond, dir=back, color="#222222", label="tasks", taillabel="1", headlabel="0..3", labeldistance=1.4];
  "staff.StaffTask" -> "model.Customer" [arrowhead=vee, color="#222222", label="target", taillabel="*", headlabel="1", labeldistance=1.4];
  "staff.ManagedStaff" -> "staff.StaffTask" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«creates»"];
  "staff.StaffTask" -> "model.Restaurant" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«acts on»"];
  "staff.StaffTask" -> "control.TurnPlan" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«validates against»"];
  "staff.Cashier" -> "model.Restaurant" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«collects payment from»"];
  note_poly2 [shape=note, style=filled, fillcolor="#fff7d6", fontsize=9, label="POLYMORPHISM (tasks)\lvalidate() and execute() differ per StaffTask subclass;\lthe controller treats every task alike (Command pattern).\l"];
  note_poly2 -> "staff.StaffTask" [style=dotted, arrowhead=none];
}
