  "ui.ManagerCommand" -> "ui.ManagerCommand$Kind" [arrowhead=vee, color="#222222", label="kind", taillabel="*", headlabel="1", labeldistance=1.4];
  "restaurant.Main" -> "control.GameController" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«creates/runs»"];
  "control.GameController" -> "staff.StaffTask" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«validates, executes»"];
  "control.GameController" -> "ui.ManagerCommand" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«reads»"];
  "control.GameConfig" -> "control.GameResult" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«creates»"];
  "ui.ConsoleUI" -> "ui.ManagerCommand" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«creates»"];
  "ui.ConsoleUI" -> "model.Restaurant" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«displays»"];
  "staff.ManagedStaff" -> "staff.StaffTask" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«creates»"];
  "staff.StaffTask" -> "model.Restaurant" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«acts on»"];
  "staff.StaffTask" -> "control.TurnPlan" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«validates against»"];
  "model.CustomerType" -> "model.Customer" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«creates»"];
  "model.ArrivalSchedule" -> "model.CustomerType" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«maps turn to»"];
  "model.Restaurant" -> "model.Order" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«creates»"];
  "staff.Cashier" -> "model.Restaurant" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«collects payment from»"];
  note_enc [shape=note, style=filled, fillcolor="#fff7d6", fontsize=9, label="ENCAPSULATION\lCustomer keeps satisfaction, state, table and order private.\lIts transitions (seatAt, placeOrder, startEating, pay, abandon)\lare package-private and only called by Restaurant, so no\lcaller can skip a step of the dining flow.\l"];
  note_enc -> "model.Customer" [style=dotted, arrowhead=none];
  note_poly [shape=note, style=filled, fillcolor="#fff7d6", fontsize=9, label="POLYMORPHISM (customers)\lgetLossPerWaitingTurn(), billFor(), chooseItem() and\lsatisfactionAtPayment() are overridden by VIP and Critic;\lGameController and Restaurant call them without type checks.\l"];
  note_poly -> "model.CriticCustomer" [style=dotted, arrowhead=none];
  note_poly -> "model.VIPCustomer" [style=dotted, arrowhead=none];
  note_comp [shape=note, style=filled, fillcolor="#fff7d6", fontsize=9, label="COMPOSITION\lRestaurant creates and owns its Tables, WaitingQueue,\lCustomers and HappyHour; they live and die with it.\lComboMeal is built from two existing MenuItems.\l"];
  note_comp -> "model.Restaurant" [style=dotted, arrowhead=none];
  note_poly2 [shape=note, style=filled, fillcolor="#fff7d6", fontsize=9, label="POLYMORPHISM (tasks)\lvalidate() and execute() differ per StaffTask subclass;\lthe controller treats every task alike (Command pattern).\l"];
  note_poly2 -> "staff.StaffTask" [style=dotted, arrowhead=none];
}
