digraph G {
  rankdir=TB;
  fontname="Helvetica"; compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  nodesep=0.35; ranksep=0.55; splines=true;
  subgraph cluster_model {
    label=<&laquo;package&raquo; restaurant.model>; style="rounded,dashed"; color="#8a94a6"; fontsize=11;
  "model.Restaurant" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>Restaurant</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- menu: Menu<BR/>- tables: List&lt;Table&gt;<BR/>- queue: WaitingQueue<BR/>- customers: List&lt;Customer&gt;<BR/>- happyHour: HappyHour<BR/>- revenueCents: int<BR/>- paidCount: int<BR/>- paidSatisfactionTotal: int<BR/>- servedCount: int<BR/>- unhappyDepartures: int</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ quote(c: Customer, item: MenuItem): int<BR/>+ finishEating(turn: int): List&lt;Customer&gt;<BR/>+ nextToPay(turn: int): Optional&lt;Customer&gt;<BR/>+ collectPayment(c: Customer)<BR/>+ seat(c: Customer): Table<BR/>+ serve(c: Customer, turn: int)<BR/>+ freeTableCount(): int<BR/>+ takeOrder(c: Customer): Order<BR/>+ endTurn()<BR/>+ findCustomer(id: int): Optional&lt;Customer&gt;<BR/>+ admit(c: Customer)<BR/>+ applyHappyHourRecovery(): Map&lt;Customer, Integer&gt;<BR/>+ applyWaitingLoss(): List&lt;Customer&gt;<BR/>+ Restaurant(menu: Menu, tableCount: int)</TD></TR>
    </TABLE>>];
  "model.Customer" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B><I>Customer</I></B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ START_SATISFACTION: int</U><BR/>- id: int<BR/>- arrivalTurn: int<BR/>- satisfaction: int<BR/>- state: CustomerState<BR/>- table: Table<BR/>- order: Order<BR/>- servedTurn: int<BR/>- readyToPayTurn: int<BR/>- recordedSatisfaction: int</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><I>+ getTypeName(): String</I><BR/><I>+ getLossPerWaitingTurn(): int</I><BR/>- require(expected: CustomerState)<BR/># satisfactionAtPayment(): int<BR/>+ chooseItem(menu: Menu): MenuItem<BR/>+ billFor(item: MenuItem): int<BR/>~ seatAt(t: Table)<BR/>~ placeOrder(o: Order)<BR/>~ startEating(turn: int)<BR/>~ finishEating(turn: int)<BR/>~ pay()<BR/>~ recoverSatisfaction(points: int): int<BR/>~ loseSatisfaction(): boolean<BR/>~ abandon()<BR/># Customer(id: int, arrivalTurn: int)</TD></TR>
    </TABLE>>];
  "model.RegularCustomer" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>RegularCustomer</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ LOSS_PER_TURN: int</U></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ RegularCustomer(id: int, arrivalTurn: int)</TD></TR>
    </TABLE>>];
  "model.VIPCustomer" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>VIPCustomer</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ LOSS_PER_TURN: int</U><BR/><U>+ BILL_PERCENT: int</U></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ billFor(item: MenuItem): int<BR/>+ VIPCustomer(id: int, arrivalTurn: int)</TD></TR>
    </TABLE>>];
  "model.CriticCustomer" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>CriticCustomer</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ LOSS_PER_TURN: int</U><BR/><U>+ REVIEW_THRESHOLD: int</U><BR/><U>+ REVIEW_SWING: int</U></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"># satisfactionAtPayment(): int<BR/>+ chooseItem(menu: Menu): MenuItem<BR/>+ CriticCustomer(id: int, arrivalTurn: int)</TD></TR>
    </TABLE>>];
  "model.CustomerType" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><FONT POINT-SIZE="8">&laquo;enumeration&raquo;</FONT><BR/><B>CustomerType</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">REGULAR<BR/>VIP<BR/>CRITIC</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><I>+ create(id: int, arrivalTurn: int): Customer</I></TD></TR>
    </TABLE>>];
  "model.CustomerState" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><FONT POINT-SIZE="8">&laquo;enumeration&raquo;</FONT><BR/><B>CustomerState</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">WAITING<BR/>SEATED<BR/>ORDERED<BR/>EATING<BR/>READY_TO_PAY<BR/>PAID<BR/>LEFT</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"> </TD></TR>
    </TABLE>>];
  "model.Order" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>Order</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- customer: Customer<BR/>- item: MenuItem<BR/>- billCents: int<BR/>- remainingUnits: int<BR/>- status: OrderStatus</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">~ cancel()<BR/>~ markPaid()<BR/>+ cookOneUnit()<BR/>~ markServed()<BR/>~ Order(customer: Customer, item: MenuItem, billCents: int)</TD></TR>
    </TABLE>>];
  "model.OrderStatus" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><FONT POINT-SIZE="8">&laquo;enumeration&raquo;</FONT><BR/><B>OrderStatus</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">PLACED<BR/>PREPARING<BR/>READY<BR/>SERVED<BR/>PAID<BR/>CANCELLED</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"> </TD></TR>
    </TABLE>>];
  "model.MenuItem" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>MenuItem</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- name: String<BR/>- priceCents: int<BR/>- prepUnits: int</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ MenuItem(name: String, priceCents: int, prepUnits: int)</TD></TR>
    </TABLE>>];
  "model.ComboMeal" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>ComboMeal</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ PRICE_PERCENT: int</U><BR/>- first: MenuItem<BR/>- second: MenuItem</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ ComboMeal(first: MenuItem, second: MenuItem)</TD></TR>
    </TABLE>>];
  "model.Menu" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>Menu</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- offerings: List&lt;MenuItem&gt;</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ add(item: MenuItem): Menu<BR/><U>+ standard(): Menu</U><BR/>+ Menu()</TD></TR>
    </TABLE>>];
  "model.Table" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>Table</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- number: int<BR/>- occupant: Customer</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">~ release()<BR/>~ occupy(customer: Customer)<BR/>+ Table(number: int)</TD></TR>
    </TABLE>>];
  "model.WaitingQueue" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>WaitingQueue</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- waiting: LinkedList&lt;Customer&gt;</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">~ remove(c: Customer)<BR/>~ join(c: Customer)<BR/>+ snapshot(): List&lt;Customer&gt;<BR/>+ WaitingQueue()</TD></TR>
    </TABLE>>];
  "model.HappyHour" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>HappyHour</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><U>+ DURATION_TURNS: int</U><BR/><U>+ BILL_PERCENT: int</U><BR/><U>+ RECOVERY_POINTS: int</U><BR/>- used: boolean<BR/>- remainingTurns: int</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ activate()<BR/>+ applyTo(billCents: int): int<BR/>+ endTurn()<BR/>+ HappyHour()</TD></TR>
    </TABLE>>];
  "model.ArrivalSchedule" [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white">
      <TR><TD ALIGN="CENTER" BGCOLOR="#e8eef7"><B>ArrivalSchedule</B></TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">- arrivals: Map&lt;Integer, CustomerType&gt;</TD></TR>
      <TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T">+ size(): int<BR/>+ add(turn: int, type: CustomerType): ArrivalSchedule<BR/>+ typeAt(turn: int): Optional&lt;CustomerType&gt;<BR/>+ ArrivalSchedule()</TD></TR>
    </TABLE>>];
  }
  "model.RegularCustomer" -> "model.Customer" [arrowhead=empty, color="#222222"];
  "model.VIPCustomer" -> "model.Customer" [arrowhead=empty, color="#222222"];
  "model.CriticCustomer" -> "model.Customer" [arrowhead=empty, color="#222222"];
  "model.ComboMeal" -> "model.MenuItem" [arrowhead=empty, color="#222222"];
  "model.Restaurant" -> "model.Table" [arrowtail=diamond, dir=back, color="#222222", label="tables", taillabel="1", headlabel="1..*", labeldistance=1.4];
  "model.Restaurant" -> "model.WaitingQueue" [arrowtail=diamond, dir=back, color="#222222", label="queue", taillabel="1", headlabel="1", labeldistance=1.4];
  "model.Restaurant" -> "model.HappyHour" [arrowtail=diamond, dir=back, color="#222222", label="happyHour", taillabel="1", headlabel="1", labeldistance=1.4];
  "model.Restaurant" -> "model.Customer" [arrowtail=diamond, dir=back, color="#222222", label="customers", taillabel="1", headlabel="0..*", labeldistance=1.4];
  "model.Restaurant" -> "model.Menu" [arrowtail=odiamond, dir=back, color="#222222", label="menu", taillabel="1", headlabel="1", labeldistance=1.4];
  "model.Menu" -> "model.MenuItem" [arrowtail=odiamond, dir=back, color="#222222", label="offerings", taillabel="1", headlabel="1..*", labeldistance=1.4];
  "model.ComboMeal" -> "model.MenuItem" [arrowtail=odiamond, dir=back, color="#222222", label="first", taillabel="1", headlabel="1", labeldistance=1.4];
  "model.ComboMeal" -> "model.MenuItem" [arrowtail=odiamond, dir=back, color="#222222", label="second", taillabel="1", headlabel="1", labeldistance=1.4];
  "model.Customer" -> "model.Order" [arrowhead=vee, color="#222222", label="order", taillabel="1", headlabel="0..1", labeldistance=1.4];
  "model.Customer" -> "model.Table" [arrowhead=vee, color="#222222", label="table", taillabel="0..1", headlabel="0..1", labeldistance=1.4];
  "model.Customer" -> "model.CustomerState" [arrowhead=vee, color="#222222", label="state", taillabel="*", headlabel="1", labeldistance=1.4];
  "model.Order" -> "model.Customer" [arrowhead=vee, color="#222222", label="customer", taillabel="0..1", headlabel="1", labeldistance=1.4];
  "model.Order" -> "model.MenuItem" [arrowhead=vee, color="#222222", label="item", taillabel="*", headlabel="1", labeldistance=1.4];
  "model.Order" -> "model.OrderStatus" [arrowhead=vee, color="#222222", label="status", taillabel="*", headlabel="1", labeldistance=1.4];
  "model.Table" -> "model.Customer" [arrowhead=vee, color="#222222", label="occupant", taillabel="0..1", headlabel="0..1", labeldistance=1.4];
  "model.WaitingQueue" -> "model.Customer" [arrowhead=vee, color="#222222", label="waiting", taillabel="0..1", headlabel="0..*", labeldistance=1.4];
  "model.CustomerType" -> "model.Customer" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«creates»"];
  "model.ArrivalSchedule" -> "model.CustomerType" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«maps turn to»"];
  "model.Restaurant" -> "model.Order" [style=dashed, arrowhead=vee, color="#555555", fontcolor="#555555", label="«creates»"];
  note_enc [shape=note, style=filled, fillcolor="#fff7d6", fontsize=9, label="ENCAPSULATION\lCustomer keeps satisfaction, state, table and order private.\lIts transitions (seatAt, placeOrder, startEating, pay, abandon)\lare package-private and only called by Restaurant, so no\lcaller can skip a step of the dining flow.\l"];
  note_enc -> "model.Customer" [style=dotted, arrowhead=none];
  note_poly [shape=note, style=filled, fillcolor="#fff7d6", fontsize=9, label="POLYMORPHISM (customers)\lgetLossPerWaitingTurn(), billFor(), chooseItem() and\lsatisfactionAtPayment() are overridden by VIP and Critic;\lGameController and Restaurant call them without type checks.\l"];
  note_poly -> "model.CriticCustomer" [style=dotted, arrowhead=none];
  note_poly -> "model.VIPCustomer" [style=dotted, arrowhead=none];
  note_comp [shape=note, style=filled, fillcolor="#fff7d6", fontsize=9, label="COMPOSITION\lRestaurant creates and owns its Tables, WaitingQueue,\lCustomers and HappyHour; they live and die with it.\lComboMeal is built from two existing MenuItems.\l"];
  note_comp -> "model.Restaurant" [style=dotted, arrowhead=none];
}
